{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blueprint",
  "version": "0.1.0",
  "identifier": "io.blueprint.commandcenter",
  "build": {
    "beforeDevCommand": "pnpm next dev",
    "beforeBuildCommand": "pnpm exec next build",
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Blueprint — AI Engineering Command Center",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "backgroundColor": "#0B0B0B",
        "theme": "Dark"
      }
    ],
    "security": {
      "capabilities": ["desktop-default"],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-src": "'none'",
        "worker-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "AI Engineering Command Center",
    "longDescription": "Blueprint is a local-first engineering workspace that unifies project intelligence, architectural memory and AI orchestration into a single command center.",
    "copyright": "Copyright © 2026 Blueprint Founding Team",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "homepage": "https://github.com/Emerald-dev0/Blueprint",
    "publisher": "Blueprint",
    "useLocalToolsDir": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../packages/personas/": "personas/"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {}
      },
      "deb": {
        "section": "devel",
        "priority": "optional",
        "recommends": ["gnome-keyring"],
        "files": {}
      },
      "rpm": {
        "release": "1",
        "epoch": 0,
        "files": {}
      }
    },
    "windows": {
      "allowDowngrades": true,
      "certificateThumbprint": null,
      "digestAlgorithm": null,
      "timestampUrl": null,
      "tsp": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Blueprint",
        "compression": "lzma",
        "displayLanguageSelector": false,
        "languages": ["English"]
      },
      "wix": null
    }
  },
  "plugins": {}
}
