{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@blueprint/ui": ["packages/ui/src"],
      "@blueprint/core": ["packages/core/src"],
      "@blueprint/ai-adapters": ["packages/ai-adapters/src"],
      "@blueprint/git-engine": ["packages/git-engine/src"],
      "@blueprint/brain": ["packages/brain/src"],
      "@blueprint/types": ["packages/types/src"]
    }
  },
  "exclude": ["node_modules"]
}
